# Drone Tag server settings. On Render, set these in the service's "Environment" tab;
# on a VPS, in the process manager (systemd / pm2) environment. No access keys are used.

# Port to listen on (Render sets this automatically).
PORT=4000

# Where images, configuration files and db.json are kept (default ./uploads).
# On a VPS point this at a persistent folder, e.g. /var/lib/drone-tag.
DATA_DIR=
# Where the saved transmission delay is kept (default ./config.json).
CONFIG_PATH=

# Secret that signs dashboard login cookies. Set a long random value
# (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# If unset, a new one is made at every start and everyone is logged out.
SESSION_SECRET=
