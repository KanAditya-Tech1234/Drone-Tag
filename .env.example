# Drone Tag server settings. On Render, set these in the service's "Environment" tab;
# on a VPS, in the process manager (systemd / pm2) environment. Never commit real values.

# Port to listen on (Render sets this automatically).
PORT=4000

# Required on any public server. Long random values, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Devices send DEVICE_API_KEY in the X-Device-Key header (or ?key= in the URL).
DEVICE_API_KEY=
# Needed by the dashboard to change the delay or clear all data (X-Admin-Key header).
ADMIN_API_KEY=

# Where images, configuration files and db.json are kept (default ./uploads).
# On a VPS point this at a persistent folder, e.g. /var/lib/drone-tag.
DATA_DIR=
# Where the saved transmission delay is kept (default ./config.json).
CONFIG_PATH=
