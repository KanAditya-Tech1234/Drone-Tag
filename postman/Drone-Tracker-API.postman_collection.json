          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('All 3 stored', () => pm.expect(pm.response.json().count).to.equal(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/packet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "packet"
              ]
            },
